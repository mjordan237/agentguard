{
  "name": "agentguard",
  "version": "0.1.0",
  "description": "Security layer for autonomous AI agents transacting onchain, built on solana-clear-sign's authenticated-IDL decoder. Started on Solana; ClearSign is its policy-and-decode engine.",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/test/*.test.js",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@solana/kora": "^0.2.1",
    "@solana/web3.js": "^1.95.0",
    "@sqds/multisig": "^2.1.4",
    "express": "^4.19.0",
    "solana-clear-sign": "github:mjordan237/solana-clear-sign#2a3594c",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0"
  }
}
