{
  "name": "agentguard",
  "version": "0.1.0",
  "description": "Transaction policy checks and human approval workflows for Solana and EVM agents.",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/test/*.test.js",
    "dev": "tsc -p tsconfig.json --watch",
    "quickstart": "node dist/demo/quickstart.js",
    "check": "node dist/src/cli/check.js",
    "backup": "node dist/src/cli/backup.js",
    "sandbox": "node dist/src/sandbox/index.js",
    "turnkey-policy": "node dist/src/turnkey/policy-template.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@solana/kora": "^0.2.1",
    "@solana/web3.js": "^1.95.0",
    "@sqds/multisig": "^2.1.4",
    "express": "^4.19.0",
    "solana-clear-sign": "github:mjordan237/solana-clear-sign#2a3594c",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.0"
  }
}
