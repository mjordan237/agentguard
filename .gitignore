node_modules/
dist/
.env
.env.*
!.env.example
!.env.sample
*.log
.DS_Store

# Generated/local-only test keypairs for scripts/kora-live-test/ -- never
# commit a private key, even a worthless devnet one, as a matter of habit.
scripts/kora-live-test/*-wallet.json
scripts/kora-live-test/*-key.json

# Local AGENTGUARD_DB_PATH default -- durable pending reviews, evaluation
# history, and daily spend live here on disk, never in git.
agentguard.sqlite
agentguard.sqlite-shm
agentguard.sqlite-wal

# Configured state files and backup copies contain customer data and credential hashes.
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
backups/

# Local handoff and generated presentation assets are not source deliverables.
REVIEW_HANDOFF.md
demo/video-render/
demo/*.mp4
